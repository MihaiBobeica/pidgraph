# Configuration. Prefer secret *references* over literal values: a file of references is inert,
# so it can be read or copied without disclosing anything, and there is no plaintext credential
# on disk to forget about.
#
# With the 1Password CLI installed and signed in, the pipeline resolves these at the moment they
# are needed:
#
#   DATABASE_URL=op://Private/pidgraph/DATABASE_URL
#
# A literal value also works if you would rather not use a password manager. A real environment
# variable always wins over both, which is how containers and CI inject secrets.

# --- server side only. Never exposed to the browser. ---
# Take the SESSION POOLER string from Project Settings -> Database -> Connection string.
# NOT the direct connection: that endpoint is IPv6-only and fails from an IPv4-only host with a
# network error that says nothing about the cause. NOT transaction mode (6543): it drops session
# features. You want port 5432 on a pooler host.
DATABASE_URL=op://Private/pidgraph/DATABASE_URL

# Optional. Not needed for writes -- the Postgres connection above already has full rights.
SUPABASE_SERVICE_ROLE_KEY=

# --- inlined into the browser bundle at build time. Row-level security is the real boundary. ---
NEXT_PUBLIC_SUPABASE_URL=op://Private/pidgraph/SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=op://Private/pidgraph/SUPABASE_ANON_KEY

# --- non-secret ---
PIDGRAPH_INPUT_DIR=data
PYTHONHASHSEED=0
