# Supabase - the single shared project, used identically by local Docker and hosted UI.
# Server-side only. NEVER expose these two to the browser.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Exposed to the browser. RLS plus REVOKE on anon is the only real boundary (see docs/assumptions.md PLAT-02).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Used once to build the committed symbol/text codebooks, then never needed again.
OPENAI_API_KEY=

# Input resolution. The repo probes both data/pid and data/p&id (README says one, disk has the other).
PIDGRAPH_INPUT_DIR=data
PIDGRAPH_STORAGE_BACKEND=local
PYTHONHASHSEED=0
